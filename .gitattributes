# Auto-detect text files and normalize to LF across all platforms
* text=auto eol=lf

# Explicit text files
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Trained checkpoints are shared through Git LFS so everyone gets identical weights (never training media).
*.pt filter=lfs diff=lfs merge=lfs -text

# Binary formats — preserve exact bytes, never alter line endings
*.npz binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.bmp binary
*.mp4 binary
*.mkv binary
*.avi binary
*.mov binary
*.webm binary
*.wav binary
*.mp3 binary
*.flac binary
*.m4a binary
*.zip binary
*.tar binary
*.gz binary
